#!/usr/bin/env bash
set -euo pipefail

log_file="${ACLI_LOG:-./acli-invocations.log}"
printf '%s\n' "$*" >> "$log_file"

case " $* " in
  *" workitem search "*)
    printf '%s\n' '{"issues":[{"key":"PROJ-10","summary":"Initiative one","status":"Open"}]}'
    ;;
  *" workitem create "*)
    if [[ " $* " == *" --type Epic "* ]]; then
      printf '%s\n' '{"key":"PROJ-101","fields":{"issuetype":{"name":"Epic"}}}'
    else
      printf '%s\n' '{"key":"PROJ-201","fields":{"issuetype":{"name":"Task"}}}'
    fi
    ;;
  *" transition-list "*)
    printf '%s\n' '{"key":"PROJ-201","transitions":[{"id":"11","name":"In Progress"},{"id":"31","name":"Done"}]}'
    ;;
  *" transition "*)
    printf '%s\n' '{"key":"PROJ-201","status":"Done"}'
    ;;
  *" comment "*)
    printf '%s\n' '{"key":"PROJ-201","ok":true}'
    ;;
  *" workitem view "*)
    printf '%s\n' '{"key":"PROJ-201","fields":{"summary":"stub issue"}}'
    ;;
  *" auth status "*)
    printf '%s\n' '{"authenticated":true}'
    ;;
  *)
    printf 'stub acli: unsupported invocation: %s\n' "$*" >&2
    exit 1
    ;;
esac
